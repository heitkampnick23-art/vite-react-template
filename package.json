{
	"name": "generate-ai",
	"description": "Generate AI — an AI app builder platform on Cloudflare. generateai.build",
	"cloudflare": {
		"label": "Generate AI",
		"products": ["Workers", "D1", "KV", "R2", "Queues", "Durable Objects"],
		"categories": ["AI", "Productivity"],
		"publish": true
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.32.1",
		"@google/generative-ai": "^0.21.0",
		"@hono/zod-validator": "^0.4.1",
		"@monaco-editor/react": "^4.6.0",
		"@stripe/stripe-js": "^4.10.0",
		"@tanstack/react-query": "^5.62.0",
		"arctic": "^2.2.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.36.4",
		"hono": "4.11.1",
		"lucide-react": "^0.460.0",
		"nanoid": "^5.0.9",
		"openai": "^4.73.1",
		"oslo": "^1.2.1",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"react-hook-form": "^7.54.0",
		"react-router-dom": "^7.0.2",
		"resend": "^4.0.1",
		"sonner": "^1.7.1",
		"stripe": "^17.4.0",
		"tailwind-merge": "^2.5.5",
		"zod": "^3.23.8",
		"zustand": "^5.0.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.15.3",
		"@eslint/js": "9.39.1",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"drizzle-kit": "^0.30.1",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"tailwindcss": "^4.0.0",
		"typescript": "5.8.3",
		"typescript-eslint": "8.48.0",
		"vite": "^6.0.0",
		"wrangler": "4.56.0"
	},
	"private": true,
	"scripts": {
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "tsc && vite build && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "vite",
		"lint": "eslint .",
		"preview": "npm run build && vite preview",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply generate-ai --local",
		"db:migrate:remote": "wrangler d1 migrations apply generate-ai --remote"
	},
	"type": "module"
}
